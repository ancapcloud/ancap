{
  "name": "ancap-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "ANCAP ACP Wallet â€” React Native monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "build": "npm run build -w @ancap/acp-wallet-sdk && npm run build -w @ancap/acp-api-client && npm run build -w @ancap/acp-bridge-client && npm run build -w @ancap/acp-bsc-client",
    "postinstall": "npm run test:security && npm run build",
    "test": "npm run test:security && npm run test --workspaces --if-present",
    "test:expo": "npm run test -w @ancap/acp-wallet-expo --",
    "test:expo:smart-pay": "npm run test -w @ancap/acp-wallet-expo -- smart-pay",
    "test:api-client": "npm run test -w @ancap/acp-api-client --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:expo": "npm run typecheck -w @ancap/acp-wallet-expo",
    "typecheck:api-client": "npm run typecheck -w @ancap/acp-api-client",
    "app:start": "npm run start -w @ancap/acp-wallet-expo",
    "app:expo": "npm run start -w @ancap/acp-wallet-expo",
    "test:security": "node --test scripts/node-forge-security.test.cjs scripts/deepmerge-security.test.cjs"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "dependencies": {
    "expo": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nfc-manager": "^4.1.0",
    "deepmerge": "file:./vendor/deepmerge-safe"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "^4.6.7"
    },
    "deepmerge": "$deepmerge",
    "minimatch": "^11.0.3",
    "glob": "^14.0.2",
    "vite": "^6.4.5"
  }
}
