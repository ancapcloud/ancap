# ANCAP Core API
# Copy to .env and adjust

# Runtime mode — "development" skips secret validation; "production" requires real secrets
ENVIRONMENT=development

# Database (sync URL for Alembic: use postgresql:// without +asyncpg)
# REQUIRED in production (ENVIRONMENT=production): do not use the local bundled-db default credentials there.
# If you use docker-compose.prod.yml with the bundled postgres service, also set POSTGRES_PASSWORD below
# and keep DATABASE_URL in sync with that real non-default password.
# Local dev example only. For the default docker-compose.yml stack, the bundled postgres service uses trust auth.
# Replace with a real passworded DSN for anything beyond throwaway local development.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/ancap
POSTGRES_PASSWORD=

# Auth — REQUIRED in production (ENVIRONMENT=production):
#   Generate with: openssl rand -hex 64
#   Never commit real keys to git. Store in CI secrets or a secret manager.
SECRET_KEY=
# Opaque cursor signing key — REQUIRED in production (ENVIRONMENT=production):
#   Generate with: openssl rand -hex 64
CURSOR_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_APP_URL=https://ancap.cloud
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Enables recovery-ready ACP wallet secret wrapping. Leave empty only if you intentionally want legacy password-only wallet encryption.
ACP_WALLET_RECOVERY_MASTER_KEY=
# Comma-separated user UUIDs allowed to approve admin-only monetization operations.
# If empty, local/dev builds allow any authenticated user to keep the operator workflow testable.
PLATFORM_ADMIN_USER_IDS=
# Comma-separated emails (case-insensitive) treated as platform admins (in addition to UUID list).
PLATFORM_ADMIN_EMAILS=dragon.cat.trx@gmail.com
# Optional Prometheus scrape token for GET /metrics (header X-Metrics-Token).
METRICS_SCRAPE_TOKEN=
# Only with ENVIRONMENT=development: allow jobs tick without CRON_SECRET.
ALLOW_INSECURE_CRON=false
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@ancap.cloud
SMTP_FROM_NAME=ANCAP Support
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
LOGIN_ALERTS_ENABLED=true

# Instantly.ai API v2 (Custom IMAP/SMTP account sync) — https://api.instantly.ai/api/v2
INSTANTLY_ENABLED=false
INSTANTLY_API_KEY=
INSTANTLY_API_BASE=https://api.instantly.ai/api/v2
INSTANTLY_TIMEOUT_SECONDS=30

# LLM execution (Teneta/Claude-compatible Anthropic API by default)
LLM_PROVIDER=teneta_claude
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.tenetauniversity.com
ANTHROPIC_API_KEY=
SMART_PAY_VISION_PROVIDER=anthropic
SMART_PAY_WEVISONE_ALLOW_LOCAL_HTTP=false
SMART_PAY_WEVISONE_URL=
SMART_PAY_WEVISONE_CA_FILE=
SMART_PAY_WEVISONE_API_KEY=
OPENAI_API_KEY=
# OpenRouter: free homepage chat and optional paid-model reserve execution.
# Never commit a real key. https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HOME_CHAT_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1800
LLM_DAILY_BUDGET_ACP=250
LLM_FALLBACK_TO_TEMPLATE=true
# Optional reserve execution through the existing OpenRouter key. Requires credit;
# routes only to providers honoring no training/data collection and zero retention.
LLM_OPENROUTER_FALLBACK_ENABLED=false
LLM_OPENROUTER_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# Stripe / fiat adapter (optional; leave empty to keep ACP-only checkout surfaces)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com/v1
# Allows a loopback /v1 mock only in development/test; ignored in production.
STRIPE_ALLOW_LOCAL_TEST_API=false

# MoonPay Commerce / Helio (https://moonpay.hel.io/developer) — never commit real keys
HELIO_PUBLIC_KEY=
HELIO_SECRET_KEY=
HELIO_PAYLINK_ID=
HELIO_WEBHOOK_SHARED_TOKEN=
HELIO_NETWORK=main
HELIO_PRIMARY_PAYMENT_METHOD=fiat
HELIO_DEFAULT_AMOUNT=10
HELIO_CURRENCY_HINT=USDC

# WebID KYC/KYB partner slot (https://webid-solutions.com/en/) — never commit real keys.
# Fail-closed: does not issue cards / Apple Pay. See docs/WEBID_KYC_AND_CARD_ISSUING_PATH.md.
WEBID_ENABLED=false
WEBID_API_BASE=
WEBID_CLIENT_ID=
WEBID_CLIENT_SECRET=
WEBID_CREATE_PATH=/api/v1/identification
WEBID_LIGHT_REDIRECT_BASE=
WEBID_RETURN_URL=https://ancap.cloud/cards
WEBID_WEBHOOK_SECRET=
WEBID_PRODUCT=VideoID

# rACP → ACP automatic redemption (exclusive reserve; never bridge hot wallet).
# See contracts/robinhood-racp/README.md and docs path in /tokens/racp/redeem.
RACP_REDEEM_ENABLED=false
EXTERNAL_TOKEN_RACP_ONLY=true
ACP_PER_EUR=100
RACP_REDEEM_PAUSED=false
RACP_REDEEM_DRY_RUN=true
RACP_CONTRACT=0xD53f91A63f95beAc61Ec8417c40C5e620FE3a911
RACP_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RACP_CHAIN_ID=4663
RACP_RESERVE_ACP_ADDRESS=acp1qqqsdr00nem230z3e84stqkx7drh2xwncupts2lz
RACP_RESERVE_KEYSTORE_FILE=/run/secrets/racp-reserve.keystore.json
RACP_REDEEM_RH_CONFIRMATIONS=3
RACP_REDEEM_ACP_CONFIRMATIONS=1
RACP_OPERATOR_SECRET=

# Referral auto-payouts (optional; leave disabled unless the ACP wallet helper + signer are configured)
REFERRAL_ONCHAIN_PAYOUT_ENABLED=false
REFERRAL_ONCHAIN_PAYOUT_KEYSTORE_FILE=
REFERRAL_ONCHAIN_PAYOUT_FEE_ACP=

# Redis-backed rate limits/cache/pubsub. Empty value keeps local in-memory fallback.
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=240

# Cron job protection — REQUIRED in production (ENVIRONMENT=production)
# If set, POST /v1/system/jobs/tick and /v1/system/jobs/tick/async require X-Cron-Secret to match this value
# Generate with: openssl rand -hex 32  or  python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# Optional
DEBUG=false

# ----------------------------
# L3: Chain anchors (mock | acp | ethereum | solana)
# ----------------------------
# Driver selection for POST /v1/chain/anchor
CHAIN_ANCHOR_DRIVER=mock

# ACP node JSON-RPC endpoint (must support method: ancap_anchor)
# Local dev: start scripts/start-acp-node.ps1 then use http://127.0.0.1:8545/rpc
# Production/public: https://acp1.ancap.cloud/rpc (requires User-Agent; backend sets it automatically)
ACP_RPC_URL=http://127.0.0.1:8545/rpc
# Optional token for submitblock/sendrawtransaction on token-gated nodes
ACP_RPC_TOKEN=
# Comma-separated emails allowed to keep the shared custodial hot deposit address.
# Leave empty unless you intentionally operate a hot-holder account.
ACP_CUSTODIAL_HOT_HOLDER_EMAILS=

# Ethereum/Solana RPC endpoints must also support custom method ancap_anchor
# (regular public RPC endpoints will NOT have this method unless you run a shim/gateway)
ETHEREUM_RPC_URL=
SOLANA_RPC_URL=

# ----------------------------
# CoinGecko (indicative market data only — never commit real keys)
COINGECKO_ENABLED=true
COINGECKO_API_KEY=
# Optional override; empty auto-selects demo vs pro host from key shape
COINGECKO_BASE_URL=
COINGECKO_CACHE_TTL_SECONDS=60
# After CoinGecko approves Wrapped ACP, set the coin id (docs/COINGECKO_LISTING_PLAYBOOK.md)
COINGECKO_WACP_COIN_ID=

# AccuWeather (Earth widget) — never commit real keys
ACCUWEATHER_ENABLED=true
ACCUWEATHER_API_KEY=
ACCUWEATHER_LANGUAGE=en-us

# Guarded rollout feature flags
# ----------------------------
FF_GRAPH_AUTO_ENFORCEMENT=false
FF_MUTATION_ENGINE=false
FF_GOVERNANCE_AUTO_APPLY=false
FF_EXTERNAL_ACTIONS=false
FF_NL_STRATEGY_COMPILER=false
FF_AETERNA=true
# Web-only USDT TRC-20 → ACP swap desk (mobile/exchange stay on). Default off in prod.
FF_WEB_USDT_TRC20_SWAP=false
